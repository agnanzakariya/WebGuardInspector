<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test runner (no NuGet), consistent with the offline-first policy.
       Swap to xUnit/MSTest later by moving the [Test] methods into a test-framework project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WebGuard.Core\WebGuard.Core.csproj" />
    <ProjectReference Include="..\..\src\WebGuard.Scanner\WebGuard.Scanner.csproj" />
    <ProjectReference Include="..\..\src\WebGuard.Detection\WebGuard.Detection.csproj" />
    <ProjectReference Include="..\..\src\WebGuard.Presentation\WebGuard.Presentation.csproj" />
    <ProjectReference Include="..\..\src\WebGuard.AI\WebGuard.AI.csproj" />
    <ProjectReference Include="..\..\src\WebGuard.Intelligence\WebGuard.Intelligence.csproj" />
    <ProjectReference Include="..\..\src\WebGuard.Persistence\WebGuard.Persistence.csproj" />
  </ItemGroup>
</Project>
