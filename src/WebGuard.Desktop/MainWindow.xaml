<Window x:Class="WebGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WebGuard.Presentation.ViewModels;assembly=WebGuard.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Azura — WebGuard Inspector" Icon="Assets/azura.ico" Width="1480" Height="920" MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="O" Command="{Binding Workspace.BrowseCommand}"/>
    <KeyBinding Key="F5" Command="{Binding Workspace.StartScanCommand}"/>
    <KeyBinding Key="Escape" Command="{Binding Workspace.CancelScanCommand}"/>
    <KeyBinding Modifiers="Control" Key="E" Command="{Binding Workspace.ExportCommand}"/>
    <KeyBinding Modifiers="Control" Key="F" Command="ApplicationCommands.Find"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind"/>
  </Window.CommandBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <Grid Margin="12,16,12,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
          <Image Source="Assets/azura-128.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="Azura logo"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding AppBrand}" Style="{StaticResource Text.Section}" FontSize="18"/>
            <TextBlock Text="{Binding AppProduct}" Style="{StaticResource Text.Caption}"/>
          </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                 ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                 AutomationProperties.Name="Primary navigation"/>

        <Border Grid.Row="2" Style="{StaticResource Inset}" Padding="12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Workspace.IsScanning}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding EngineStateText}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Local analysis engine" Style="{StaticResource Text.Caption}" Margin="17,2,0,0"/>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" Margin="17,0,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===== Main area ===== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top bar -->
      <Grid Margin="24,16,20,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource Text.PageTitle}"/>
          <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Text.Secondary}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Scan  ·  Analyze  ·  Understand  ·  Build Safer" Style="{StaticResource Text.Caption}"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding ToggleThemeCommand}" FontSize="16"
                ToolTip="Toggle dark / light theme" AutomationProperties.Name="Toggle theme" VerticalAlignment="Center">
          <Button.Content>
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE708;"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                      <Setter Property="Text" Value="&#xE706;"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button.Content>
        </Button>
      </Grid>

      <ContentControl x:Name="PageHost" Grid.Row="1" Margin="24,12,20,20" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
  </Grid>
</Window>
