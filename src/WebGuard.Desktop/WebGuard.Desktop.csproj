<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WebGuard.Desktop</RootNamespace>
    <AssemblyName>WebGuard.Desktop</AssemblyName>
    <AssemblyTitle>Azura — WebGuard Inspector</AssemblyTitle>
    <Product>Azura — WebGuard Inspector</Product>
    <ApplicationIcon>Assets\azura.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\azura.ico" />
    <Resource Include="Assets\azura-128.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebGuard.Core\WebGuard.Core.csproj" />
    <ProjectReference Include="..\WebGuard.Scanner\WebGuard.Scanner.csproj" />
    <ProjectReference Include="..\WebGuard.Detection\WebGuard.Detection.csproj" />
    <ProjectReference Include="..\WebGuard.Intelligence\WebGuard.Intelligence.csproj" />
    <ProjectReference Include="..\WebGuard.AI\WebGuard.AI.csproj" />
    <!-- Ships WebGuard.Mcp.exe next to the app so MCP clients can launch it. -->
    <ProjectReference Include="..\WebGuard.Mcp\WebGuard.Mcp.csproj" />
    <ProjectReference Include="..\WebGuard.Persistence\WebGuard.Persistence.csproj" />
    <ProjectReference Include="..\WebGuard.Presentation\WebGuard.Presentation.csproj" />
  </ItemGroup>
</Project>
