<UserControl x:Class="WebGuard.Desktop.Views.Controls.WorkflowHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebGuard.Presentation.ViewModels;assembly=WebGuard.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScanWorkspaceViewModel}">
  <!-- Select Folder → Scan → Investigate. DataContext: ScanWorkspaceViewModel. -->
  <UserControl.Resources>
    <Style x:Key="StepCircle" TargetType="Border">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="StepArrow" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
      <Setter Property="Text" Value="&#xE72A;"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}" Padding="20,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="56"/>
        <ColumnDefinition Width="Auto" MinWidth="250"/>
        <ColumnDefinition Width="56"/>
        <ColumnDefinition Width="Auto" MinWidth="230"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Step 1 -->
      <StackPanel Orientation="Horizontal">
        <Border Style="{StaticResource StepCircle}" Tag="{Binding IsStep1Complete}">
          <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Select Folder" Style="{StaticResource Text.Section}"/>
          <TextBlock Text="{Binding FolderHint}" Style="{StaticResource Text.Caption}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="1" Style="{StaticResource StepArrow}"/>

      <!-- Step 2 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Border Style="{StaticResource StepCircle}" Tag="{Binding IsStep2Complete}">
          <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Scan" Style="{StaticResource Text.Section}"/>
          <TextBlock Text="Inventory and hash files (F5)" Style="{StaticResource Text.Caption}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="3" Style="{StaticResource StepArrow}"/>

      <!-- Step 3 -->
      <StackPanel Grid.Column="4" Orientation="Horizontal">
        <Border Style="{StaticResource StepCircle}" Tag="{Binding IsStep3Active}">
          <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Investigate" Style="{StaticResource Text.Section}"/>
          <TextBlock Text="Review files and insights" Style="{StaticResource Text.Caption}"/>
        </StackPanel>
      </StackPanel>

      <!-- Folder picker -->
      <Grid Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Tag="D:\Projects\MyApp"
                   Padding="38,9,36,9" FontSize="13.5" AutomationProperties.Name="Folder path"
                   IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
          <TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
          <Button Content="&#xE711;" Style="{StaticResource Button.Icon}" Command="{Binding ClearFolderCommand}"
                  HorizontalAlignment="Right" Margin="0,0,4,0" FontSize="11" ToolTip="Clear folder"
                  AutomationProperties.Name="Clear folder"/>
        </Grid>
        <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseCommand}" Margin="10,0,0,0"
                ToolTip="Browse for a folder (Ctrl+O)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8DA;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="14"/>
            <TextBlock Text="Browse Folder" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Start / Cancel -->
      <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
        <Button Style="{StaticResource Button.Primary}" Command="{Binding StartScanCommand}" Padding="16,10"
                ToolTip="Start scan (F5)"
                Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="14"/>
            <TextBlock Text="Start Scan" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Button.Danger}" Command="{Binding CancelScanCommand}" Padding="16,10"
                ToolTip="Cancel scan (Esc)"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71A;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Danger}" FontSize="14"/>
            <TextBlock Text="Cancel Scan" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Progress -->
      <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="0,14,0,0"
            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar Grid.ColumnSpan="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource Text.Caption}">
          <Run Text="{Binding ProgressText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding CurrentFile, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"/>
        </TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" Text="{Binding ElapsedText}" Style="{StaticResource Text.Caption}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
