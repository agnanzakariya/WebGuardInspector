<UserControl x:Class="WebGuard.Desktop.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebGuard.Presentation.ViewModels;assembly=WebGuard.Presentation"
             xmlns:controls="clr-namespace:WebGuard.Desktop.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FindingsViewModel}">
  <UserControl.Resources>
    <Style x:Key="SeverityTile" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <DataTemplate x:Key="EngineRunTemplate">
      <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}"
                       TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Pill.Tone}" VerticalAlignment="Top" Margin="12,0,0,0">
            <TextBlock Text="{Binding Outcome}" Style="{StaticResource Text.Tone}" FontSize="11.5" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="370"/>
    </Grid.ColumnDefinitions>

    <!-- Severity summary -->
    <UniformGrid Grid.ColumnSpan="2" Rows="1" Columns="5">
      <Border Style="{StaticResource SeverityTile}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="Total" Style="{StaticResource Text.Secondary}"/>
          <TextBlock Text="{Binding TotalText}" Style="{StaticResource Text.Value}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SeverityTile}" Margin="3,0">
        <StackPanel>
          <TextBlock Text="Critical" Style="{StaticResource Text.Base}" Foreground="{DynamicResource Brush.Severity.Critical}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary.Critical}" Style="{StaticResource Text.Value}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SeverityTile}" Margin="3,0">
        <StackPanel>
          <TextBlock Text="High" Style="{StaticResource Text.Base}" Foreground="{DynamicResource Brush.Severity.High}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary.High}" Style="{StaticResource Text.Value}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SeverityTile}" Margin="3,0">
        <StackPanel>
          <TextBlock Text="Medium" Style="{StaticResource Text.Base}" Foreground="{DynamicResource Brush.Severity.Medium}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary.Medium}" Style="{StaticResource Text.Value}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SeverityTile}" Margin="6,0,0,0">
        <StackPanel>
          <TextBlock Text="Low" Style="{StaticResource Text.Base}" Foreground="{DynamicResource Brush.Severity.Low}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary.Low}" Style="{StaticResource Text.Value}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Finding list -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,12,0" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Engine outcomes stay visible while findings are listed, so a skipped engine is never silent. -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding EngineRuns}" Margin="16,4,16,12"
                      Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Pill.Tone}" Margin="0,0,8,6" Padding="10,3" ToolTip="{Binding Message}">
                <TextBlock Style="{StaticResource Text.Base}" FontSize="12">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Outcome, Mode=OneWay}" Foreground="{DynamicResource Brush.Info}"/>
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="16,12,12,8">
          <TextBlock Text="Security Findings" Style="{StaticResource Text.Section}" VerticalAlignment="Center"/>
          <Grid Width="260" HorizontalAlignment="Right">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search findings… (Ctrl+F)"
                     Padding="34,7,10,7" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search findings"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding, Mode=TwoWay}" Margin="6,0,6,6"
                  Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Severity" Width="110" SortMemberPath="Severity">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Pill.Severity}">
                    <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.4*" ElementStyle="{StaticResource Cell.Code}"/>
            <DataGridTemplateColumn Header="Issue" Width="1.4*" SortMemberPath="Title">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <DockPanel VerticalAlignment="Center">
                    <Border DockPanel.Dock="Left" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="{StaticResource Radius.Pill}"
                            Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="CISA Known Exploited Vulnerability"
                            Visibility="{Binding IsKnownExploited, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="KEV" Foreground="{DynamicResource Brush.Danger}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Cell.Text}"/>
                  </DockPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="0.8*" ElementStyle="{StaticResource Cell.Secondary}"/>
            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.8*" ElementStyle="{StaticResource Cell.Secondary}"/>
          </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,4,16,16"
                      Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="34" Foreground="{DynamicResource Brush.Info}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.Section}" Margin="0,12,0,4"/>
            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Wrap}" Margin="0,0,0,16"/>
            <TextBlock Text="DETECTION ENGINES" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding EngineCatalog.Engines}" ItemTemplate="{StaticResource EngineStatusTemplate}"
                          Visibility="{Binding HasEngineRuns, Converter={StaticResource InverseBoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding EngineRuns}" ItemTemplate="{StaticResource EngineRunTemplate}"
                          Visibility="{Binding HasEngineRuns, Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Finding detail -->
    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelectedFinding, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding SelectedFinding}">
          <WrapPanel Margin="0,0,0,10">
            <Border Style="{StaticResource Pill.Severity}" Margin="0,0,0,4">
              <TextBlock Text="{Binding SeverityText}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
            </Border>
            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="{StaticResource Radius.Pill}" Padding="8,1" Margin="8,0,0,4"
                    VerticalAlignment="Center" Visibility="{Binding IsKnownExploited, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Known exploited" Foreground="{DynamicResource Brush.Danger}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,4">
              <Run Text="{Binding CategoryText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ConfidenceText, Mode=OneWay}"/>
            </TextBlock>
          </WrapPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" TextWrapping="Wrap" TextTrimming="None"/>
          <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Code}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,2" TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12" TextWrapping="Wrap">
            <Run Text="{Binding Engine, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RuleId, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Wrap}"/>

          <TextBlock Text="EVIDENCE" Style="{StaticResource Text.Label}" Margin="0,14,0,6"
                     Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}"/>
          <ItemsControl ItemsSource="{Binding Evidence}" Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}"/>
                    <TextBox Text="{Binding RedactedSnippet, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Code}" FontSize="12"
                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="REFERENCES" Style="{StaticResource Text.Label}" Margin="0,12,0,6"
                     Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibility}}"/>
          <TextBlock Text="{Binding References}" Style="{StaticResource Text.Code}" TextWrapping="Wrap"
                     Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibility}}"/>

          <TextBlock Text="REMEDIATION" Style="{StaticResource Text.Label}" Margin="0,14,0,6"
                     Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}"/>
          <Border Style="{StaticResource Inset}" Background="{DynamicResource Brush.SuccessSoft}"
                  Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Remediation}" Style="{StaticResource Text.Wrap}"/>
          </Border>

          <!-- AI analysis of this finding (page-level state, so it uses the page's DataContext). -->
          <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,18,0,0"
                      Visibility="{Binding HasAnalyst, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <TextBlock Text="AI ANALYST" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelAnalysisCommand}" Padding="10,5" Margin="0,0,8,0"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
                <Button Style="{StaticResource Button.Primary}" Command="{Binding AnalyzeCommand}" Padding="12,5"
                        ToolTip="Explain this finding with the local model. Secrets are redacted; nothing is changed.">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.OnPrimary}"/>
                    <TextBlock Text="Analyze with AI" Margin="6,0,0,0" FontSize="12"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                         Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding AnalysisMessage}" Style="{StaticResource Text.Wrap}" FontSize="12" Margin="0,8,0,0"/>
            <StackPanel DataContext="{Binding CurrentAnalysis}" Margin="0,8,0,0"
                        Visibility="{Binding DataContext.HasCurrentAnalysis, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource Inset}" Background="{DynamicResource Brush.WarningSoft}">
                <TextBlock Text="AI hypothesis — not verified. Validate before acting; nothing was changed." Style="{StaticResource Text.Base}"
                           Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"/>
              </Border>
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Wrap}" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <TextBlock Text="WHY IT MATTERS" Style="{StaticResource Text.Label}" Margin="0,10,0,4"
                         Visibility="{Binding HasWhyRisky, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Text="{Binding WhyRisky}" Style="{StaticResource Text.Wrap}"
                         Visibility="{Binding HasWhyRisky, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Text="PROPOSED FIX (review before applying)" Style="{StaticResource Text.Label}" Margin="0,10,0,4"
                         Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}"/>
              <Border Style="{StaticResource Inset}" Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}">
                <TextBox Text="{Binding Remediation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                         Padding="0" FontFamily="{StaticResource Font.Code}" FontSize="12"/>
              </Border>
              <TextBlock Text="{Binding Footer}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>

          <Border Style="{StaticResource Inset}" Margin="0,14,0,0" Background="{DynamicResource Brush.WarningSoft}"
                  Visibility="{Binding IsAiHypothesis, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="AI hypothesis — not verified. Validate before acting." Style="{StaticResource Text.Base}" Foreground="{DynamicResource Brush.Warning}"/>
          </Border>
          <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Code}" FontSize="10.5"
                     TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>
        </ScrollViewer>
        <StackPanel VerticalAlignment="Center" Visibility="{Binding HasSelectedFinding, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="Finding Detail" Style="{StaticResource Text.Section}" HorizontalAlignment="Center"/>
          <TextBlock Text="Select a finding to see its evidence (secrets redacted), references and remediation."
                     Style="{StaticResource Text.Wrap}" TextAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
