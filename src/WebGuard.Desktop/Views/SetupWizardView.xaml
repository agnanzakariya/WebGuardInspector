<UserControl x:Class="WebGuard.Desktop.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebGuard.Presentation.ViewModels;assembly=WebGuard.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}">
  <UserControl.Resources>
    <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource Segmented}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,4,0,14"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
    <Style x:Key="StatusBox" TargetType="Border" BasedOn="{StaticResource Pill.Tone}">
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Background}">
    <Grid MaxWidth="1100" Margin="32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Steps -->
      <StackPanel Margin="0,0,24,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
          <Image Source="../Assets/azura-128.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Azura" Style="{StaticResource Text.Section}" FontSize="20"/>
            <TextBlock Text="WebGuard Inspector setup" Style="{StaticResource Text.Caption}"/>
          </StackPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Row" CornerRadius="{StaticResource Radius.Control}" Padding="10,8" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.SurfaceAlt}">
                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                  </Border>
                  <TextBlock x:Name="Label" Text="{Binding Title}" Style="{StaticResource Text.Base}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                  <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                  <Setter TargetName="Num" Property="Text" Value="&#x2713;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                  <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}"/>
                  <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                  <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,18,0,0"
                   Text="Setup must be finished before Azura can be used. Every choice can be changed later in Settings."/>
      </StackPanel>

      <!-- Current step -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="28,24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Caption}">
              <Run Text="Step "/><Run Text="{Binding StepNumber, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding StepCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.PageTitle}" Margin="0,2,0,14"/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <!-- 1 Welcome -->
              <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}" FontSize="14"
                           Text="Azura inspects source code on this PC: it inventories and hashes files, runs security engines (Semgrep, Gitleaks, OSV-Scanner, YARA-X), checks threat intelligence, and can explain and fix findings with AI."/>
                <TextBlock Style="{StaticResource Text.Wrap}" Margin="0,12,0,0"
                           Text="This setup takes a few minutes. For each optional feature you decide whether to use it; nothing is sent off this PC unless you allow it here."/>
                <Border Style="{StaticResource Inset}" Margin="0,18,0,0">
                  <StackPanel>
                    <TextBlock Text="YOU WILL CHOOSE" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="• Which security engines are ready (bundled ones work right away)"/>
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="• Online threat intelligence (OSV.dev, CISA KEV, abuse.ch) — or offline only"/>
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="• A local AI analyst (LM Studio / Ollama)"/>
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="• Fixing with Claude (Claude Code CLI, your own Claude login)"/>
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="• A Second Brain vault in Obsidian"/>
                    <TextBlock Style="{StaticResource Text.Wrap}" Text="• Theme and scanning preferences"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 2 Engines -->
              <StackPanel Visibility="{Binding IsEngines, Converter={StaticResource BoolToVisibility}}" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}"
                           Text="Gitleaks, OSV-Scanner and YARA-X ship with the installer. Semgrep (needs Python) and ClamAV (antivirus, needs administrator rights) are installed by Setup when you ticked them; otherwise use Start menu → Install or repair dependencies, or winget install Cisco.ClamAV. ClamAV also needs its signature database: download it in Settings → Components. Engines that are not ready are skipped and reported; you can set their paths in Settings later."/>
                <Grid Margin="0,14,0,8">
                  <TextBlock Text="{Binding EngineCatalog.Summary}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource Button.Secondary}" Content="Check again" Command="{Binding RefreshEnginesCommand}" Padding="12,5" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding EngineCatalog.Engines}" ItemTemplate="{StaticResource EngineStatusTemplate}" Focusable="False"/>
              </StackPanel>

              <!-- 3 Privacy -->
              <StackPanel Visibility="{Binding IsPrivacy, Converter={StaticResource BoolToVisibility}}" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}"
                           Text="Online lookups send package names and versions to OSV.dev, download the public CISA KEV catalog, and send SHA-256 hashes of executables/archives to abuse.ch. Source code is never uploaded."/>
                <TextBlock Text="Threat intelligence" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding IntelChoices}" SelectedItem="{Binding IntelChoice, Mode=TwoWay}"
                         AutomationProperties.Name="Threat intelligence choice"/>
                <StackPanel Visibility="{Binding UsesOnlineLookups, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="abuse.ch Auth-Key (optional; enables MalwareBazaar and ThreatFox)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding AbuseChKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Tag="free key from auth.abuse.ch"
                           AutomationProperties.Name="abuse.ch key"/>
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="Stored in your user settings file only. Leave empty to skip the malware hash lookups."/>
                </StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckUpdates, Mode=TwoWay}"
                          Content="Check GitHub for new versions when Azura starts (once a day)"/>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Only the public release information of the app is requested from api.github.com. You can always check by hand in Settings → Updates."/>
              </StackPanel>

              <!-- 4 Local AI -->
              <StackPanel Visibility="{Binding IsAiAnalyst, Converter={StaticResource BoolToVisibility}}" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}"
                           Text="The AI analyst explains findings with a model running on this PC (LM Studio or Ollama, OpenAI-compatible API on localhost). Only redacted excerpts are sent to it."/>
                <TextBlock Text="Local AI analyst" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding FeatureChoices}" SelectedItem="{Binding AiChoice, Mode=TwoWay}"
                         AutomationProperties.Name="Local AI choice"/>
                <StackPanel Visibility="{Binding UsesAi, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Endpoint (local only)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Tag="http://127.0.0.1:1234/v1"
                           AutomationProperties.Name="AI endpoint"/>
                  <TextBlock Text="Model (empty = first loaded chat model)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Tag="auto" AutomationProperties.Name="AI model"/>
                  <Button Style="{StaticResource Button.Secondary}" Content="Test connection" Command="{Binding TestAiCommand}" Padding="12,5" Margin="0,12,0,0"
                          HorizontalAlignment="Left"/>
                  <Border Style="{StaticResource StatusBox}" DataContext="{Binding AiResult}"
                          Visibility="{Binding DataContext.HasAiResult, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Wrap}"/>
                  </Border>
                </StackPanel>
              </StackPanel>

              <!-- 5 Claude -->
              <StackPanel Visibility="{Binding IsClaude, Converter={StaticResource BoolToVisibility}}" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}"
                           Text="The Fixing page asks Claude (Claude Code CLI, under your own Claude subscription) to propose code changes. Only the redacted file of a finding is sent to Anthropic; you review every change before it is written."/>
                <TextBlock Text="Fixing with Claude" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding FeatureChoices}" SelectedItem="{Binding ClaudeChoice, Mode=TwoWay}"
                         AutomationProperties.Name="Claude choice"/>
                <StackPanel Visibility="{Binding UsesClaude, Converter={StaticResource BoolToVisibility}}">
                  <Border Style="{StaticResource Inset}">
                    <TextBlock Style="{StaticResource Text.Wrap}"
                               Text="Sign in once: open a terminal, run  claude  (or %USERPROFILE%\.local\bin\claude.exe) and type /login. Then press Check."/>
                  </Border>
                  <TextBlock Text="Path to claude.exe (empty = auto-detect)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Tag="auto"
                           AutomationProperties.Name="Claude path"/>
                  <TextBlock Text="Model (empty = Claude Code default; e.g. sonnet, opus)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Tag="default"
                           AutomationProperties.Name="Claude model"/>
                  <Button Style="{StaticResource Button.Secondary}" Content="Check Claude Code" Command="{Binding CheckClaudeCommand}" Padding="12,5" Margin="0,12,0,0"
                          HorizontalAlignment="Left"/>
                  <Border Style="{StaticResource StatusBox}" DataContext="{Binding ClaudeResult}"
                          Visibility="{Binding DataContext.HasClaudeResult, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Wrap}"/>
                  </Border>
                </StackPanel>
              </StackPanel>

              <!-- 6 Second Brain -->
              <StackPanel Visibility="{Binding IsSecondBrain, Converter={StaticResource BoolToVisibility}}" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}"
                           Text="The Second Brain records every scan (including clean ones), finding, AI analysis and verdict as linked Markdown notes in an Obsidian vault, and lets you search them later."/>
                <TextBlock Text="Second Brain" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding FeatureChoices}" SelectedItem="{Binding VaultChoice, Mode=TwoWay}"
                         AutomationProperties.Name="Second Brain choice"/>
                <StackPanel Visibility="{Binding UsesVault, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Vault folder (must exist)" Style="{StaticResource FieldLabel}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Tag="D:\2nd Brain\WebGuard"
                             AutomationProperties.Name="Vault folder"/>
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Browse…" Command="{Binding BrowseVaultCommand}" Padding="12,5" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding VaultHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRecord, Mode=TwoWay}" Content="Record every scan and AI result automatically"
                            Margin="0,12,0,0"/>
                </StackPanel>
              </StackPanel>

              <!-- 7 Preferences -->
              <StackPanel Visibility="{Binding IsPreferences, Converter={StaticResource BoolToVisibility}}" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding ThemeChoice, Mode=TwoWay}"
                         AutomationProperties.Name="Theme"/>
                <TextBlock Text="Files read in parallel" Style="{StaticResource FieldLabel}"/>
                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding ParallelismOptions}" SelectedItem="{Binding Parallelism, Mode=TwoWay}"
                         AutomationProperties.Name="Parallelism"/>
                <TextBlock Text="Folder names never scanned (one per line; &quot;wreck&quot; is always skipped)" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource TextBox.MultiLine}" Text="{Binding ExcludedText, UpdateSourceTrigger=PropertyChanged}" Height="150"
                         FontFamily="{StaticResource Font.Code}" AutomationProperties.Name="Excluded folders"/>
              </StackPanel>

              <!-- 8 Summary -->
              <StackPanel Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Text.Wrap}" Text="Review your choices. Finish saves them and opens Azura."/>
                <ItemsControl ItemsSource="{Binding Summary}" Margin="0,14,0,0" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Wrap}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- Footer -->
          <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Button.Secondary}" Content="Back" Command="{Binding BackCommand}" Padding="16,7"/>
            <TextBlock Grid.Column="1" Text="{Binding ValidationMessage}" Style="{StaticResource Text.Wrap}" Foreground="{DynamicResource Brush.Warning}"
                       VerticalAlignment="Center" Margin="16,0" TextAlignment="Right"/>
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{Binding NextText}" Command="{Binding NextCommand}" Padding="22,7"
                    IsDefault="True" AutomationProperties.Name="Next step"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
