<UserControl x:Class="WebGuard.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebGuard.Presentation.ViewModels;assembly=WebGuard.Presentation"
             xmlns:controls="clr-namespace:WebGuard.Desktop.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="460"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="APPEARANCE" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Content="Dark theme (default)"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="SCANNING" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
            <TextBlock Text="Excluded folder names (one per line, matched at any depth)" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <TextBox Style="{StaticResource TextBox.MultiLine}" Text="{Binding ExcludedDirectoriesText, UpdateSourceTrigger=PropertyChanged}"
                     Height="170" AutomationProperties.Name="Excluded folders"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Hash limit (MB)" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding MaxHashMegabytesText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                         AutomationProperties.Name="Hash limit in megabytes"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <TextBlock Text="Parallel file readers" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding ParallelismOptions}" SelectedItem="{Binding Parallelism, Mode=TwoWay}"
                         HorizontalAlignment="Left" AutomationProperties.Name="Parallel file readers"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Wrap}" FontSize="12" Margin="0,12,0,0"
                       Text="Scans are read-only. Symbolic links and junctions are never followed, so a scan cannot leave the selected folder."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="AI ANALYST (LOCAL)" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AiEnabled, Mode=TwoWay}" Content="Enable AI analysis with a local model"/>
            <TextBlock Text="OpenAI-compatible endpoint (local only)" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6"/>
            <TextBox Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                     Tag="http://127.0.0.1:1234/v1" AutomationProperties.Name="AI endpoint"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="LM Studio: http://127.0.0.1:1234/v1 (Developer → Start Server). Ollama: http://127.0.0.1:11434/v1. Remote endpoints are rejected."/>
            <TextBlock Text="Model (empty = first loaded chat model)" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6"/>
            <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                     Tag="auto" AutomationProperties.Name="AI model"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="FIXING WITH CLAUDE" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClaudeFixEnabled, Mode=TwoWay}" Content="Propose fixes with the Claude Code CLI"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Uses your own Claude login (run &quot;claude&quot; once and sign in with /login). The redacted file of the finding is sent to Anthropic; Claude runs without tools, so it cannot read the project or change files. You apply each change yourself."/>
            <TextBlock Text="Path to claude.exe (empty = auto-detect)" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6"/>
            <TextBox Text="{Binding ClaudeCliPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                     Tag="%USERPROFILE%\.local\bin\claude.exe" AutomationProperties.Name="Claude Code path"/>
            <TextBlock Text="Model (empty = Claude Code default; e.g. sonnet, opus)" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6"/>
            <TextBox Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                     Tag="default" AutomationProperties.Name="Claude model"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="SECOND BRAIN (OBSIDIAN)" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
            <TextBlock Text="Obsidian vault folder" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                       Tag="e.g. D:\2nd Brain\WebGuard" AutomationProperties.Name="Second Brain vault folder"/>
              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Browse" Command="{Binding BrowseVaultCommand}" Margin="8,0,0,0" Padding="12,5"/>
            </Grid>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoRecord, Mode=TwoWay}" Margin="0,12,0,0"
                      Content="Record every scan and AI analysis automatically"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Notes are plain Markdown with properties and links (Projects, Scans, Findings, Rules, Dashboard). Secrets are redacted before writing; your own text in a note is never overwritten. Leave empty to turn the Second Brain off."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="PRIVACY" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllowExternalIntelligence, Mode=TwoWay}"
                      Content="Allow external threat-intelligence lookups"/>
            <TextBlock Style="{StaticResource Text.Wrap}" FontSize="12" Margin="50,6,0,0"
                       Text="When enabled, only package names/versions (OSV-Scanner, OSV.dev) and SHA-256 hashes (MalwareBazaar, ThreatFox) are sent. The public CISA KEV catalog is downloaded. Source code and credentials never leave this machine."/>
            <TextBlock Text="abuse.ch Auth-Key (MalwareBazaar and ThreatFox hash lookups, optional)" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6"/>
            <TextBox Text="{Binding AbuseChAuthKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                     Tag="Paste the free key from auth.abuse.ch" AutomationProperties.Name="abuse.ch Auth-Key"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Stored in the per-user settings file below. Leave empty to skip hash lookups."/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button Style="{StaticResource Button.Primary}" Content="Save Settings" Command="{Binding SaveCommand}"/>
          <Button Style="{StaticResource Button.Secondary}" Content="Restore Defaults" Command="{Binding ResetCommand}" Margin="10,0,0,0"/>
          <Button Style="{StaticResource Button.Secondary}" Content="Run setup wizard" Command="{Binding RunSetupCommand}" Margin="10,0,0,0"
                  ToolTip="Go through the first-run setup again"/>
          <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
          <Run Text="Settings file: "/><Run Text="{Binding SettingsFile, Mode=OneWay}" FontFamily="{StaticResource Font.Code}"/>
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1">
      <!-- Updates -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding About}"
              Visibility="{Binding DataContext.HasAbout, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <Grid>
            <TextBlock Text="UPDATES" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource Button.Secondary}" Content="Check now" Command="{Binding CheckNowCommand}" Padding="12,4" HorizontalAlignment="Right"/>
          </Grid>
          <Border Style="{StaticResource Pill.Tone}" HorizontalAlignment="Stretch" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Wrap}"/>
          </Border>
          <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoCheck, Mode=TwoWay}" Margin="0,10,0,0"
                    Content="Check GitHub when Azura starts (once a day)"/>
          <StackPanel Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
            <TextBlock Text="{Binding ReleaseTitle}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Inset}" Margin="0,6,0,0" MaxHeight="180">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource Text.Wrap}" FontSize="12"/>
              </ScrollViewer>
            </Border>
            <TextBlock Text="{Binding InstallHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="{StaticResource Font.Code}"/>
            <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{StaticResource Button.Primary}" Content="Download &amp; install" Command="{Binding InstallUpdateCommand}" Padding="14,6"
                      ToolTip="Downloads the installer from GitHub, verifies its SHA-256 and runs it after you confirm"/>
              <Button Style="{StaticResource Button.Secondary}" Content="Release page" Command="{Binding OpenReleaseCommand}" Padding="12,6" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding About}"
              Visibility="{Binding DataContext.HasAbout, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="ABOUT" Style="{StaticResource Text.Label}" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Image Source="../Assets/azura-128.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Brand}" Style="{StaticResource Text.Section}" FontSize="20"/>
              <TextBlock Text="{Binding Product}" Style="{StaticResource Text.Secondary}"/>
              <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Wrap}" FontSize="12" Margin="0,12,0,0"/>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0">
            <Run Text="By "/><Run Text="{Binding Author, Mode=OneWay}"/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="GitHub" Command="{Binding OpenRepositoryCommand}" Padding="12,4"
                    ToolTip="{Binding Repository}"/>
            <Button Style="{StaticResource Button.Secondary}" Content="Report a problem" Command="{Binding OpenIssuesCommand}" Padding="12,4" Margin="8,0,0,0"/>
          </StackPanel>

          <Grid Margin="0,18,0,6">
            <TextBlock Text="COMPONENTS" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource Button.Link}" Content="Refresh" Command="{Binding RefreshComponentsCommand}" HorizontalAlignment="Right"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Components}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"/>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource Pill.Tone}" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Tone}" FontSize="11.5" FontWeight="SemiBold"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding EngineCatalog.Engines}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource Pill.Tone}" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource Text.Tone}" FontSize="11.5" FontWeight="SemiBold">
                      <TextBlock.Text>
                        <PriorityBinding>
                          <Binding Path="Version"/>
                          <Binding Path="Availability"/>
                        </PriorityBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="DATA LOCATIONS" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
          <ItemsControl ItemsSource="{Binding Locations}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Code}" TextWrapping="Wrap" TextTrimming="None"/>
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource Button.Link}" Content="Open" Command="{Binding OpenCommand}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="0,0,0,6" DataContext="{Binding VaultLocation}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Base}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Code}" TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Link}" Content="Open" Command="{Binding OpenCommand}" VerticalAlignment="Top" Margin="8,0,0,0"/>
          </Grid>

          <TextBlock Text="THIRD-PARTY LICENSES" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
          <ItemsControl ItemsSource="{Binding Licenses}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Base}">
                      <Run Text="{Binding Component, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding License, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Usage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource Button.Link}" Content="License" Command="{Binding OpenCommand}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="SECURITY ENGINES" Style="{StaticResource Text.Label}" Margin="0,0,0,10"/>
          <ItemsControl ItemsSource="{Binding EngineCatalog.Engines}" ItemTemplate="{StaticResource EngineStatusTemplate}"/>
          <TextBlock Text="ENGINE EXECUTABLES" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
          <TextBlock Style="{StaticResource Text.Wrap}" FontSize="12" Margin="0,0,0,10"
                     Text="Absolute path to each .exe. Leave empty to auto-detect an installed .exe (PATH, WinGet, Scoop, Go, Cargo); the resolved absolute path is shown above. Scripts (.cmd/.bat) are never run."/>
          <ItemsControl ItemsSource="{Binding EngineSettings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Name}"/>
                  <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}" Margin="0,6,0,0"
                           Tag="Auto-detect" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} executable path'}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Text="Custom rule files can be set per engine with EngineRulePaths in settings.json; otherwise the bundled rules are used. Press Save Settings to apply."/>
        </StackPanel>
      </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
