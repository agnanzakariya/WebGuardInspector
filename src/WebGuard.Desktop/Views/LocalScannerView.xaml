<UserControl x:Class="WebGuard.Desktop.Views.LocalScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebGuard.Presentation.ViewModels;assembly=WebGuard.Presentation"
             xmlns:controls="clr-namespace:WebGuard.Desktop.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LocalScannerViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="370"/>
    </Grid.ColumnDefinitions>

    <controls:WorkflowHeader Grid.ColumnSpan="2" DataContext="{Binding Workspace}"/>

    <!-- Toolbar: policy, status filter, export -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Success}"/>
            <TextBlock Text="{Binding ScanPolicySummary}" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding Workspace.StatusMessage}" Style="{StaticResource Text.Caption}" Margin="22,3,0,0"/>
        </StackPanel>
        <ListBox Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding StatusFilters}"
                 SelectedItem="{Binding Workspace.StatusFilter, Mode=TwoWay}" Margin="12,0" VerticalAlignment="Center"
                 AutomationProperties.Name="Status filter"/>
        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding Workspace.ExportCommand}"
                ToolTip="Export JSON report (Ctrl+E)" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="Export JSON" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <controls:FileInventoryPanel Grid.Row="2" Margin="0,12,12,0" DataContext="{Binding Workspace}"/>
    <controls:FileDetailsPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" DataContext="{Binding Workspace}"/>
  </Grid>
</UserControl>
